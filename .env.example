# AlertProcessor 配置文件示例
# 复制此文件为 .env 并修改配置

# ============================================
# 开发者配置（用于并行开发）
# ============================================
# 开发者名称（可选，用于隔离数据库和配置）
# 设置后会自动为数据库文件添加后缀，如 alerts_alice.db
# DEVELOPER_NAME=alice

# 或者直接指定数据库后缀
# DEVELOPER_DB_SUFFIX=_alice

# ============================================
# API 配置
# ============================================
API_KEY=default_secret_key_change_in_production

# ============================================
# 数据库配置
# ============================================
DATABASE_URL=sqlite:///./alerts.db

# ============================================
# 应用配置
# ============================================
APP_NAME=Alert Webhook Service
APP_DESCRIPTION=用于接收和处理告警信息的Webhook服务
APP_VERSION=1.0.0

# ============================================
# 服务器配置
# ============================================
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ============================================
# 风险检测配置
# ============================================
RISK_CHECK_ENABLED=true
RISK_CHECK_DEFAULT_SCORE=PENDING

# ============================================
# 外部 API 配置
# ============================================
# Moralis API Key（支持多 Key 轮换）
# 单个 Key: MORALIS_API_KEY=your_key
# 多个 Key: MORALIS_API_KEY=["key1", "key2", "key3"]
# MORALIS_API_KEY=

# ARKM Cookie
# ARKM_COOKIE=

# BlockSec Cookie
# BLOCKSEC_COOKIE=

# 通知 Webhook URL
# NOTIFY_WEBHOOK_URL=

# ============================================
# MarketDataBase 服务配置
# ============================================
MARKET_DB_URL=http://localhost:8002

# ============================================
# APIPool Server 配置
# ============================================
# APIPool Server 地址
# APIPOOL_SERVER_URL=http://localhost:8000
# APIPOOL_USERNAME=
# APIPOOL_PASSWORD=

# 每条链对应的 pool identifier
# JSON 格式: {"1": "ethereum-rpc", "56": "bsc-rpc", "137": "polygon-rpc"}
# APIPOOL_POOL_MAP={}

# Moralis API Key Pool Identifier
# MORALIS_POOL_IDENTIFIER=moralis-keys

# ============================================
# 区块时间配置
# ============================================
# JSON 格式: {"1": 12, "56": 3, "137": 2}
# key=chain_id, value=单块时间(秒)
# BLOCK_TIME_CONFIG={}

# ============================================
# 日志接收配置
# ============================================
INGEST_ENABLED=true
INGEST_MAX_BATCH_SIZE=5000

# ============================================
# AI 配置（规则链生成 / MCP 工具）
# ============================================
AI_ENABLED=false
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=60
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
